RewriteEngine On

# 1) Redirect www.valevphoto.studio -> valevphoto.studio
RewriteCond %{HTTP_HOST} ^www\.valevphoto\.studio$ [NC]
RewriteRule ^(.*)$ https://valevphoto.studio/$1 [L,R=301]

# 1.1) Redirect /index.php -> /
RewriteCond %{THE_REQUEST} \s/+index\.php[ \?]
RewriteRule ^index\.php$ https://%{HTTP_HOST}/ [R=301,L]

# 1.2) Redirect root-level page.php -> /page (exclude admin/api/vendor paths)
RewriteCond %{REQUEST_URI} !^/admin/ [NC]
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{REQUEST_URI} !^/vendor/ [NC]
RewriteCond %{THE_REQUEST} \s/([A-Za-z0-9_-]+)\.php[ \?]
RewriteRule ^([A-Za-z0-9_-]+)\.php$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2) If someone requests /views/page.php directly, redirect to clean URL (/page)
RewriteCond %{THE_REQUEST} \s/+views/([^\s?]+)\.php[ \?] [NC]
RewriteRule ^views/.+\.php$ https://valevphoto.studio/%1 [R=301,L]

# 3) Pretty URLs:
#    /catalogo  -> views/catalogo.php
#    /clases    -> views/clases.php
#    /ubicacion -> views/ubicacion.php
#    /redes-sociales -> views/redes-sociales.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/views/$1.php -f
RewriteRule ^([^/]+)/?$ views/$1.php [L]

# 4) Default index file (root)
DirectoryIndex index.php index.html
