RewriteEngine On

# 1) Redirect www.valevphoto.studio -> valevphoto.studio
RewriteCond %{HTTP_HOST} ^www\.valevphoto\.studio$ [NC]
RewriteRule ^(.*)$ https://valevphoto.studio/$1 [L,R=301]

# 2) Redirect specific HTML pages to PHP (if someone hits the old .html URLs)
RewriteRule ^index\.html$ index.php [R=301,L]
RewriteRule ^clases\.html$ clases.php [R=301,L]
RewriteRule ^ubicacion\.html$ ubicacion.php [R=301,L]
RewriteRule ^catalogo\.html$ catalogo.php [R=301,L]
RewriteRule ^redes-sociales\.html$ redes-sociales.php [R=301,L]

# 3) Pretty URLs: /clases -> clases.php, /redes-sociales -> redes-sociales.php, etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# 4) Default index file
DirectoryIndex index.php index.html
